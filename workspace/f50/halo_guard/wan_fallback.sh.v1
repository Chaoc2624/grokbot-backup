#!/system/bin/sh
# wlan1 relay -> cellular fallback for mihomo. Runs every 30s from ufi_tools_boot.sh.
# Disable: touch /data/halo_guard/wan_fallback.disabled
D=/data/halo_guard; LOG=$D/wan_fallback.log; ST=$D/wan_fallback.state
[ -f $D/wan_fallback.disabled ] && exit 0
API=http://127.0.0.1:7788; AUTH="Authorization: Bearer 123456"
[ -f $D/tg.conf ] && . $D/tg.conf   # TG_TOKEN= TG_CHAT=  (chmod 600)
CD=600
log(){ echo "$(date '+%m-%d %H:%M:%S') $*" >> $LOG; [ "$(wc -c < $LOG)" -gt 200000 ] && mv -f $LOG $LOG.1; }
tg(){ [ -n "$TG_TOKEN" ] || return; now=$(date +%s); last=$(cat $D/wan_fallback.tglast 2>/dev/null || echo 0)
  [ $((now-last)) -lt $CD ] && { log "tg suppressed (cooldown)"; return; }
  for o in "--interface sipa_eth8" "-x http://127.0.0.1:7890" ""; do
    curl -s -m 15 $o "https://api.telegram.org/bot$TG_TOKEN/sendMessage" --data-urlencode "chat_id=$TG_CHAT" --data-urlencode "text=$1" -o /dev/null -w '%{http_code}' | grep -q 200 && { echo $now > $D/wan_fallback.tglast; return; }
  done; log "tg send failed"; }
ok(){ c=$(curl -s -o /dev/null -m 6 --interface wlan1 -w '%{http_code}' http://connect.rom.miui.com/generate_204); [ "$c" = 204 ]; }
set_if(){ curl -s -m5 -X PATCH -H "$AUTH" $API/configs -d "{\"interface-name\":\"$1\"}" -o /dev/null; curl -s -m5 -X DELETE -H "$AUTH" $API/connections -o /dev/null; }
read mode fails < $ST 2>/dev/null; mode=${mode:-wlan1}; fails=${fails:-0}
T=$(date '+%Y-%m-%d %H:%M:%S')
if ok; then fails=0
  [ "$mode" = sipa_eth8 ] && { set_if wlan1; mode=wlan1; log "wlan1 recovered -> mihomo back to wlan1"; tg "✅ F50 中继恢复 $T
原因: alibaba-guest(wlan1) 探测恢复
当前上游: WiFi 中继 wlan1"; }
else fails=$((fails+1))
  if [ "$mode" = wlan1 ] && [ $fails -ge 2 ]; then set_if sipa_eth8; mode=sipa_eth8; log "wlan1 down x$fails -> mihomo to sipa_eth8"; tg "⚠️ F50 中继断开 $T
原因: wlan1 连续 $fails 次探测 connect.rom.miui.com 失败
当前上游: 5G 蜂窝 sipa_eth8"; fi
fi
echo "$mode $fails" > $ST
