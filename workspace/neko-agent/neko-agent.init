#!/bin/sh /etc/rc.common
# Neko Master agent -> https://neko.omnitools.cc (reports OpenClash/mihomo traffic)
USE_PROCD=1
START=99
STOP=10
PROG=/usr/bin/neko-agent
CONF=/etc/neko-agent/gl.env

start_service() {
	[ -f "$CONF" ] || return 1
	. "$CONF"
	procd_open_instance
	procd_set_param command "$PROG" \
		--server-url "$NEKO_SERVER" \
		--backend-id "$NEKO_BACKEND_ID" \
		--backend-token "$NEKO_BACKEND_TOKEN" \
		--gateway-type "$NEKO_GATEWAY_TYPE" \
		--gateway-url "$NEKO_GATEWAY_URL" \
		--max-pending-updates 10000 \
		--log=false
	[ -n "$NEKO_GATEWAY_TOKEN" ] && procd_append_param command --gateway-token "$NEKO_GATEWAY_TOKEN"
	procd_set_param env GOGC=50 GOMEMLIMIT=24MiB
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
