  },
  {
    "id": "2120533108017791460",
    "username": "runwayml",
    "created_at": "2026-11-11T15:04:25.000Z",
    "metrics": {
      "bookmark_count": 7,
      "impression_count": 2722,
      "like_count": 24,
      "quote_count": 1,
      "reply_count": 2,
      "retweet_count": 1
    },
    "text": "Praxis-1 is a 27B-parameter mixture-of-experts diffusion transformer that predicts video and actions together. We detail the model's architecture, training stages and results in our technical report.\n\nhttps://t.co/5T3RnNEsd1",
    "urls": [
      "https://runway.com/research/praxis-1-video-pretraining-to-robot-control"
    ],
    "note": "",
    "refs": [],
    "url": "https://x.com/runwayml/status/2120533108017791460"
  },
  {
