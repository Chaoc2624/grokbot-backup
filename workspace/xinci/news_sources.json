{
  "window_hours": 24,
  "max_items": 80,
  "max_keywords": 16,
  "pause_sec": 0.8,
  "notes": "免密钥、非 X 补充源。不要加入 Toolify/Futurepedia/Aixploria sitemap、Product Hunt、HN（已在 AI工具轨）。不要启用 Horizon 的 twitter/openbb/email/wechat/webhook/pages/Apify/Playwright/Firecrawl。",
  "google_news": {
    "enabled": true,
    "language": "en-US",
    "country": "US",
    "ceid": "US:en",
    "max_results_per_query": 20,
    "queries": [
      {
        "id": "ai-tool",
        "q": "(\"new AI tool\" OR \"AI tool launch\" OR \"launches AI tool\" OR \"releases AI tool\")",
        "kind_hint": "ai_tool"
      },
      {
        "id": "steam-release",
        "q": "(\"released on Steam\" OR \"now available on Steam\")",
        "kind_hint": "game"
      },
      {
        "id": "model-announce",
        "q": "(\"announces\" OR \"unveils\" OR \"introduces\") (\"language model\" OR \"open-source model\" OR \"open-weight model\" OR \"open weight\")",
        "kind_hint": "model"
      },
      {
        "id": "ai-available",
        "q": "(\"just launched\" OR \"now available\") (AI OR \"language model\") (tool OR agent OR model)",
        "kind_hint": "ai_tool"
      },
      {
        "id": "zh-launch",
        "q": "(发布 OR 推出 OR 上线 OR 开源) (模型 OR AI工具 OR 新游戏 OR Steam OR Roblox)",
        "kind_hint": "",
        "language": "zh-CN",
        "country": "CN",
        "ceid": "CN:zh-Hans"
      }
    ]
  },
  "gdelt": {
    "enabled": true,
    "timespan": "24h",
    "max_records": 25,
    "mode": "ArtList",
    "queries": [
      {
        "id": "ai-tool",
        "q": "\"new AI tool\" OR \"AI tool launch\" OR \"launches an AI\"",
        "kind_hint": "ai_tool"
      },
      {
        "id": "steam-release",
        "q": "\"released on Steam\" OR \"now available on Steam\"",
        "kind_hint": "game"
      },
      {
        "id": "model-available",
        "q": "(\"now available\" OR unveils OR introducing) (LLM OR \"language model\" OR \"open-source model\")",
        "kind_hint": "model"
      }
    ]
  },
