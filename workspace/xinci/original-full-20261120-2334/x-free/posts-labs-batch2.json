      "article": {
        "title": "Hitting REDLINE: How to Make a Cinematic Racing Film with Kling 4.0"
      },
      "author_id": "1799294856822673408",
      "created_at": "2026-11-20T11:22:10.000Z",
      "edit_history_tweet_ids": [
        "2123738670335209519"
      ],
      "id": "2123738670335209519",
      "public_metrics": {
        "bookmark_count": 1,
        "impression_count": 2579,
        "like_count": 18,
        "quote_count": 0,
        "reply_count": 9,
        "retweet_count": 1
      },
      "text": "Explore how Stephane Benini @BeniniStep9801 combines creative storytelling and AI filmmaking techniques to bring Redline to life with Kling 4.0. #KlingAI #Kling4 https://t.co/xlu8HcfVhP",
      "url": "https://x.com/Kling_ai/status/2123738670335209519"
    },
    {
      "author_id": "1799294856822673408",
